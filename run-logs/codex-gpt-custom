#!/usr/bin/env bash
CODEX=${CODEX_BIN:-/usr/local/bin/codex}
if [[ "${1:-}" == "--version" ]]; then
  exec "$CODEX" "$@"
fi

: "${OPENAI_API_KEY:?Set OPENAI_API_KEY before running this wrapper}"
: "${OPENAI_BASE_URL:?Set OPENAI_BASE_URL to the Responses API base URL, usually ending in /v1}"

OPENAI_BASE_URL=${OPENAI_BASE_URL%/}
if [[ "$OPENAI_BASE_URL" == *'"'* || "$OPENAI_BASE_URL" == *'\'* ]]; then
  echo "OPENAI_BASE_URL contains unsupported quote or backslash characters" >&2
  exit 2
fi

if [[ "${1:-}" == "exec" ]]; then
  shift
  exec "$CODEX" exec \
    --config 'model_provider="gpt_custom"' \
    --config 'model_providers.gpt_custom.name="Custom GPT Responses endpoint"' \
    --config "model_providers.gpt_custom.base_url=\"$OPENAI_BASE_URL\"" \
    --config 'model_providers.gpt_custom.env_key="OPENAI_API_KEY"' \
    --config 'model_providers.gpt_custom.wire_api="responses"' \
    --config 'model_providers.gpt_custom.requires_openai_auth=false' \
    --config 'shell_environment_policy.set.PATH="/data/projects/math-harness-eval/RLMEval/run-logs/bin:/usr/local/bin:/usr/bin:/bin"' \
    "$@"
fi
exec "$CODEX" "$@"
