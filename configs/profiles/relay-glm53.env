# GLM-5.3 @ 内部中转(token.pjlab.org.cn,API key 鉴权)
# 接入方式: relay — 凭据从 secret.txt「内部中转」段读取(见 scripts/model-env.sh)
FLAVOR=relay
MODEL=${MODEL:-glm-5.3}
SECRET_SECTION=${SECRET_SECTION:-内部中转}
NO_PROXY_DOMAIN=${NO_PROXY_DOMAIN:-.pjlab.org.cn}
NO_OUTPUT_SCHEMA=${NO_OUTPUT_SCHEMA-0}
# 远程接口默认非流式;glm-5.3 经中转默认自带思考,无需显式 effort
STREAM=${STREAM-0}
REASONING_EFFORT=${REASONING_EFFORT-}
