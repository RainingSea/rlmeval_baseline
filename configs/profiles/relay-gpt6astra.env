# GPT-6-Astra @ 外部中转(API key 鉴权)
# 接入方式: relay — 凭据从 secret.txt「外部中转」段读取(见 scripts/model-env.sh)
FLAVOR=relay
MODEL=${MODEL:-gpt-6-astra}
SECRET_SECTION=${SECRET_SECTION:-外部中转}
NO_PROXY_DOMAIN=${NO_PROXY_DOMAIN:-.pjlab.org.cn}
NO_OUTPUT_SCHEMA=${NO_OUTPUT_SCHEMA-0}
STREAM=${STREAM-0}
REASONING_EFFORT=${REASONING_EFFORT-high}
